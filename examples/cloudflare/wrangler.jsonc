{
  "name": "nanocode-egress-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "containers": [
    {
      "class_name": "RelayContainer",
      "image": "./node_modules/nanocode-egress/relay.Dockerfile",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PLANS", "class_name": "PlanVault" },
      { "name": "RELAY", "class_name": "RelayContainer" },
      { "name": "SESSIONS", "class_name": "AgentSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PlanVault", "RelayContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["AgentSession"] }
  ],
  "vars": {
    "RECOVERY_DELAY_MS": "5000",
    "EVENT_STREAM_KEEPALIVE_MS": "5000",
    "EVENT_PAGE_SIZE": "128",
    "EVENT_TAIL_BYTES": "4194304",
    "EVENT_COALESCE_MS": "100",
    "MODEL_SOCKET_LINGER_MS": "30000",
    "RUNTIME_MEMORY_BUDGET_BYTES": "67108864",
    "REMOTE_MAX_FRAME_BYTES": "1048576",
    "REMOTE_TIMEOUT_MS": "30000"
  }
}
